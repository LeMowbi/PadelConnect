{
  "expo": {
    "name": "PadelConnect",
    "slug": "padelconnect",
    "owner": "padelconnect-ci",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "padelco",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EFEADF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ci.padelco.app",
      "buildNumber": "69",
      "associatedDomains": [
        "applinks:padelconnectci.com",
        "webcredentials:padelconnectci.com"
      ],
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fr",
        "CFBundleLocalizations": [
          "fr"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ci.padelco.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#00544D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "padelconnectci.com",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "padelconnectci.com",
              "pathPrefix": "/club"
            },
            {
              "scheme": "https",
              "host": "padelconnectci.com",
              "path": "/auth-callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "locales": {
      "fr": {
        "ios": {
          "CFBundleDisplayName": "PadelConnect"
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EFEADF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PadelConnect accède à tes photos pour ta photo de profil et, côté gérant, les photos de ton club.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0C6A57"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "PadelConnect ajoute tes réservations de padel à ton calendrier, avec ton accord.",
          "remindersPermission": "PadelConnect n’accède à tes rappels qu’avec ton accord, uniquement pour tes réservations de padel."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "PadelConnect accède à tes contacts, avec ton accord, uniquement pour t’aider à retrouver et inviter tes amis par leur numéro."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "13532c92-65c9-4afc-9977-a45bfbe1f777"
      }
    }
  }
}
